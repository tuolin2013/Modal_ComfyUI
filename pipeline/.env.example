# right.codes 令牌配置（参见令牌管理页 https://www.right.codes/api-keys）
# Base URL（固定）：https://www.right.codes/v1

# ─── 层 1：策划层 LLM 令牌（「Claude awsq」高质量 Key）───────────────────────
RIGHT_CODES_LLM_KEY=sk-替换为你的Claude_awsq令牌

# 策划模型（right.codes 模型列表中选择，推荐 Claude 3.5 Sonnet 或 gpt-4o）
PLANNING_MODEL=claude-3-5-sonnet-20240620

# ─── 层 2：视觉资产层图像令牌（「draw」画图 Key）────────────────────────────
RIGHT_CODES_DRAW_KEY=sk-替换为你的draw令牌

# 图像模型选择（截图中可见的模型）：
#   gpt-image-2.5          高质量精图，商品棚拍推荐
#   gpt-image-2.5-sunburst 变体版本
#   nano-banana-2          中等质量，快速
#   nano-banana-2-lite     最便宜，草图校验用
IMAGE_MODEL=gpt-image-2.5

# 图像尺寸（带货竖版 9:16 推荐 1024x1792，正方形 1024x1024）
IMAGE_SIZE=1024x1792
