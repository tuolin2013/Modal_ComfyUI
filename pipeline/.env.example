# 复制本文件为 pipeline/.env 后填写。pipeline/.env 已被 .gitignore 忽略，切勿提交。
# 令牌在 Right Code（https://www.right.codes/）后台创建；接口域名为 https://www.rightapi.ai

# ─── 必填：令牌 ──────────────────────────────────────────────────────────────
# 文本模型令牌：卖点分析、剧本分镜、H3 提示词、主图/详情页策划
RIGHT_CODES_LLM_KEY=sk-your-llm-key
# 画图令牌：产品参考图、角色定妆照、基底图、主图/详情页
RIGHT_CODES_DRAW_KEY=sk-your-draw-key

# ─── 选填：文本模型 ──────────────────────────────────────────────────────────
# 必须是平台上可用的模型名
PLANNING_MODEL=claude-opus-5-5
# 单次 LLM 请求超时（秒）；完整剧本常要 2 分钟以上
LLM_TIMEOUT=300

# ─── 选填：生图模型 ──────────────────────────────────────────────────────────
# 定妆照 / 基底图。可选 gpt-image-2.5（高质量）、nano-banana-2 等，以平台模型列表为准
IMAGE_MODEL=gpt-image-2.5
# 兜底尺寸（正常由界面里的「目标平台」决定）
IMAGE_SIZE=1008x1792

# 主图 / 详情页
ECOM_IMAGE_MODEL=gpt-image-2.5
RIGHT_CODES_DRAW_URL=https://www.rightapi.ai/draw/v1
# 同时出几张图（各自提交任务、各自轮询）。平台报 429 限流时调小
# ECOM_CONCURRENCY=4

# 程序叠字的排版引擎：html（默认，HTML/CSS 模板 + 无头 Chromium，需先运行 python -m playwright install chromium）
# 或 pil（Pillow 简版，不需要浏览器，不支持角标/价格标签/参数表的样式）。Chromium 不可用时会自动退回 pil
# ECOM_RENDERER=html

# 中文字体（程序叠字用）。不填则自动查找系统字体：
#   Windows 微软雅黑 / 黑体，macOS 苹方 / 华文黑体，Linux Noto Sans CJK / 文泉驿微米黑
# ECOM_FONT=C:/Windows/Fonts/msyh.ttc
# ECOM_FONT_BOLD=C:/Windows/Fonts/msyhbd.ttc

# ─── 选填：模式 A（ComfyUI）──────────────────────────────────────────────────
# modal serve / deploy comfyui_minimax_h3_modal.py 后打印的地址；不填则界面不显示跳转按钮
# COMFYUI_URL=https://<your-modal-username>--comfyui-minimax-h3-ui-dev.modal.run
